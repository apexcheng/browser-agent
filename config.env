BROWSER_AGENT_HOME="${BROWSER_AGENT_HOME:-$HOME/browser-agent}"
CHROME_PROFILE_DIR="${CHROME_PROFILE_DIR:-$BROWSER_AGENT_HOME/chrome-profile}"
CHROME_BIN="${CHROME_BIN:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
CDP_HOST="${CDP_HOST:-127.0.0.1}"
CDP_PORT="${CDP_PORT:-19312}"
CDP_URL="http://${CDP_HOST}:${CDP_PORT}"
BROWSER_AGENT_SESSION="${BROWSER_AGENT_SESSION:-browser-agent}"
